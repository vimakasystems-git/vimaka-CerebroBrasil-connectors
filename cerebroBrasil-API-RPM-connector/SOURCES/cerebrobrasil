#!/usr/bin/env bash
set -Eeuo pipefail

umask 077
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cerebrobrasil"
URL_FILE="$CONFIG_DIR/api-url"
TOKEN_FILE="$CONFIG_DIR/token"
DEFAULT_URL="https://cerebrobrasil.com.br"

[[ ! -L "$CONFIG_DIR" && ! -L "$URL_FILE" && ! -L "$TOKEN_FILE" ]] || { echo "Refusing symlinked configuration." >&2; exit 1; }
mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_DIR"

api_url() {
  [[ -s "$URL_FILE" ]] && cat "$URL_FILE" || printf '%s' "$DEFAULT_URL"
}

token() {
  if [[ -s "$TOKEN_FILE" ]]; then cat "$TOKEN_FILE"; fi
}

detect() {
  echo "Kernel: $(uname -s)"
  echo "Architecture: $(uname -m)"
  if [[ -r /etc/os-release ]]; then
    # shellcheck source=/dev/null
    . /etc/os-release
    echo "Distribution: ${PRETTY_NAME:-unknown}"
    echo "ID: ${ID:-unknown}"
    echo "Version: ${VERSION_ID:-unknown}"
  fi
}

doctor() {
  detect
  echo "curl: $(command -v curl || echo missing)"
  echo "jq: $(command -v jq || echo missing)"
  echo "API URL: $(api_url)"
  [[ -s "$TOKEN_FILE" ]] && echo "API token: configured" || echo "API token: not configured"
}

validate_url() {
  local url="$1"
  local https='^https://[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?(/[A-Za-z0-9._~/%+-]*)?$'
  local loopback='^http://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]{1,5})?(/[A-Za-z0-9._~/%+-]*)?$'
  [[ "$url" =~ $https || "$url" =~ $loopback ]] || { echo "Use HTTPS (HTTP only on localhost), without credentials/query/fragment." >&2; return 1; }
}

save_private() {
  local target="$1" value="$2" temporary
  temporary="$(mktemp "$CONFIG_DIR/.config.XXXXXX")"
  if ! printf '%s' "$value" > "$temporary" || ! mv -f -- "$temporary" "$target"; then
    rm -f -- "$temporary"
    return 1
  fi
}

set_url() {
  local url="${1:-}"
  validate_url "$url"
  save_private "$URL_FILE" "${url%/}"
  echo "API URL configured."
}

set_token() {
  local value
  read -rsp "CerebroBrasil API token: " value
  echo
  [[ "$value" =~ ^[A-Za-z0-9._~+/-]+=*$ ]] || { echo "Invalid Bearer token." >&2; exit 1; }
  save_private "$TOKEN_FILE" "$value"
  echo "Token stored locally in $TOKEN_FILE"
}

clear_token() {
  rm -f "$TOKEN_FILE"
  echo "Local API token removed."
}

request() {
  local method="$1" path="$2" data="${3:-}" base t
  base="$(api_url)"
  t="$(token)"
  validate_url "$base"
  [[ "$path" == /* && "$path" != //* && ! "$path" =~ [[:space:]\\] ]] || { echo "PATH must start with a single / and contain no whitespace or backslashes." >&2; exit 1; }
  [[ -z "$t" || "$t" =~ ^[A-Za-z0-9._~+/-]+=*$ ]] || { echo "Invalid stored token." >&2; exit 1; }
  local -a args=(-q -fsS --globoff --connect-timeout 10 --max-time 60 --proto '=https,http' -X "$method" -H 'Accept: application/json')
  if [[ -n "$data" ]]; then
    args+=(-H 'Content-Type: application/json' --data-raw "$data")
  fi
  if [[ -n "$t" ]]; then
    # Header goes over stdin, never through argv/process listings; no redirects are followed.
    printf 'Authorization: Bearer %s\n' "$t" | curl "${args[@]}" -H @- --url "${base}${path}"
  else
    curl "${args[@]}" --url "${base}${path}"
  fi
}

ping() {
  local base
  base="$(api_url)"
  validate_url "$base"
  echo "Testing $base ..."
  curl -q -fsS --globoff --connect-timeout 10 --max-time 60 --proto '=https,http' -o /dev/null -w 'HTTP %{http_code} | %{time_total}s\n' --url "$base/"
}

case "${1:-help}" in
  detect) detect ;;
  doctor) doctor ;;
  ping) ping ;;
  config)
    case "${2:-}" in
      set-url) set_url "${3:-}" ;;
      set-token) set_token ;;
      clear-token) clear_token ;;
      show) echo "API URL: $(api_url)"; [[ -s "$TOKEN_FILE" ]] && echo "Token: configured" || echo "Token: not configured" ;;
      *) echo "Usage: cerebrobrasil config {set-url URL|set-token|clear-token|show}"; exit 1 ;;
    esac ;;
  get) request GET "${2:-/}" ;;
  post) request POST "${2:-/}" "${3:-}" ;;
  put) request PUT "${2:-/}" "${3:-}" ;;
  delete) request DELETE "${2:-/}" ;;
  help|-h|--help)
    cat <<'EOF'
CerebroBrasil API CLI
  cerebrobrasil detect
  cerebrobrasil doctor
  cerebrobrasil ping
  cerebrobrasil config show
  cerebrobrasil config set-url URL
  cerebrobrasil config set-token
  cerebrobrasil config clear-token
  cerebrobrasil get PATH
  cerebrobrasil post PATH JSON
  cerebrobrasil put PATH JSON
  cerebrobrasil delete PATH
EOF
    ;;
  *) echo "Unknown command. Use: cerebrobrasil help"; exit 1 ;;
esac
